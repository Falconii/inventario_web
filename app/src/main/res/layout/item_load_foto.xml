<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ll_load_foto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white">

    <ImageView
        android:id="@+id/foto_item_load_image"
        android:layout_width="130dp"
        android:layout_height="130dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5" />

    <ImageButton
        android:id="@+id/foto_item_load_upload"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:background="@color/white"
        android:src="@drawable/icons8_upload_to_cloud_24"
        app:layout_constraintEnd_toStartOf="@+id/foto_item_load_destaque"
        app:layout_constraintTop_toTopOf="parent"/>

    <ImageButton
        android:id="@+id/foto_item_load_destaque"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:background="@color/white"
        android:src="@drawable/star_24_yellow"
        app:layout_constraintEnd_toStartOf="@+id/foto_item_load_consulta"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/foto_item_load_consulta"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:background="@color/white"
        android:src="@drawable/show_24_blue"
        app:layout_constraintEnd_toStartOf="@+id/foto_item_load_delete"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/foto_item_load_delete"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:background="@color/white"
        android:src="@drawable/delete_24_red"
        app:layout_constraintEnd_toStartOf="@+id/foto_item_load_edicao"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/foto_item_load_edicao"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:background="@color/white"
        android:src="@drawable/pencil_24_green"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/foto_item_load_txt_ativo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:text="Código:"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/foto_item_load_image"
        app:layout_constraintTop_toBottomOf="@+id/foto_item_load_consulta" />

    <TextView
        android:id="@+id/foto_item_load_txt_descricao"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:text="Descricao"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/foto_item_load_image"
        app:layout_constraintTop_toBottomOf="@+id/foto_item_load_txt_ativo" />


    <TextView
        android:id="@+id/foto_item_load_txt_usuario"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:text="Nome Usuário"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/foto_item_load_image"
        app:layout_constraintTop_toBottomOf="@+id/foto_item_load_txt_descricao" />

    <TextView
        android:id="@+id/foto_item_load_txt_obs"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:text="Observação"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@+id/foto_item_load_image"
        app:layout_constraintTop_toBottomOf="@+id/foto_item_load_txt_usuario"
        app:layout_constraintVertical_bias="0.09" />

    <TextView
        android:id="@+id/foto_item_load_txt_situacao"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:text="Situação"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/foto_item_load_txt_obs" />
</androidx.constraintlayout.widget.ConstraintLayout>